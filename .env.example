# ---------------------------------------------------------------------------
# Filament-Lager – Konfiguration (kopieren nach .env und ausfüllen)
# ---------------------------------------------------------------------------

# Zufälliges Secret zum Signieren der Sessions, z. B. erzeugen mit:
#   openssl rand -hex 32
APP_SECRET=bitte-zufaelligen-wert-eintragen

# PostgreSQL-Verbindung
DATABASE_URL=postgres://benutzer:passwort@localhost:5432/filament_lager

# Nur für den Umstieg von MySQL: Ist diese Variable gesetzt, übernimmt die
# App beim Start einmalig alle Daten aus der alten MySQL-Datenbank. Der Lauf
# ist idempotent und wiederholbar; das Ergebnis steht im Verwaltungsbereich
# unter /verwaltung/system. Danach die Zeile wieder entfernen.
# LEGACY_MYSQL_URL=mysql://benutzer:passwort@localhost:3306/filament_lager

# Telegram-Bot (bei @BotFather anlegen, siehe README)
TELEGRAM_BOT_TOKEN=123456789:ABCdeFGhiJKlmnoPQRstuVWxyz
TELEGRAM_BOT_USERNAME=DeinFilamentLagerBot

# Zugriffsbeschränkung: kommagetrennte Telegram-User-IDs.
# Deine eigene ID erfährst du, indem du dem Bot /id schreibst.
#
# Ist die Liste leer, meldet sich niemand an – es sei denn, du öffnest die
# Registrierung unten ausdrücklich. Das ist bewusst so: Wer die Variable
# übersieht, soll keine offene Instanz betreiben, ohne es zu merken.
TELEGRAM_ALLOWED_IDS=123456789

# Registrierung für jeden Telegram-Nutzer öffnen (nur mit leerer Liste oben
# sinnvoll). Damit bist du datenschutzrechtlich für die Daten unbestimmt
# vieler Personen verantwortlich – siehe PRIVACY.md und COMPLIANCE.md.
# TELEGRAM_OPEN_REGISTRATION=1

# Diese Telegram-ID wird Admin (typischerweise deine eigene).
#
# Fehlt sie, wird der allererste registrierte Benutzer Admin – aber nur, wenn
# oben eine Freigabeliste steht. Bei offener Registrierung gibt es keine
# Automatik, sonst bekäme der erste Fremde die Verwaltung.
OWNER_TELEGRAM_ID=123456789

# ---------------------------------------------------------------------------
# Betreiberangaben für Impressum und Datenschutzerklärung
#
# Pflicht, sobald die Instanz für andere erreichbar ist: Wer sie betreibt, ist
# datenschutzrechtlich Verantwortlicher (Art. 4 Nr. 7 DSGVO, Art. 5 lit. j
# revDSG) und muss sich benennen. Fehlen die Angaben, weisen /impressum und
# /datenschutz sichtbar darauf hin.
#
# Für eine rein private Instanz, die nur du selbst nutzt, kannst du sie leer
# lassen.
# ---------------------------------------------------------------------------
LEGAL_OPERATOR_NAME=Vorname Nachname

# Anschrift, mehrzeilig. Zeilenumbrüche als \n schreiben – diese Form
# übersteht jeden Weg, den der Wert nehmen kann: diese Datei, `environment:`
# in docker-compose.yml, `docker run -e` und Plattformen, die das Abbild
# selbst bauen.
#
# Ein gequoteter Wert mit echten Umbrüchen geht hier ebenfalls. Aber KEINE
# echten Zeilenumbrüche in ein Eingabefeld einer Deployment-Oberfläche
# einfügen: Wer die Variablen in den Bau durchreicht (z. B. Coolify), bekommt
# dort einen Abbruch, weil die zweite Zeile als nächste Anweisung gelesen
# wird.
#
# Windows-Zeilenenden, Leerzeilen und Leerräume am Zeilenrand werden in jedem
# Fall bereinigt – ebenso ein zweites Mal escapte Werte (`\\n` statt `\n`),
# wie sie manche Plattformen beim Schreiben in den Bau erzeugen.
#
# Kein <br> verwenden: Die Rechtsseiten sind Markdown, rohes HTML wird
# bewusst verworfen und stünde als sichtbarer Text da.
LEGAL_OPERATOR_ADDRESS=Strasse 1\n1234 Ort\nSchweiz

LEGAL_OPERATOR_EMAIL=kontakt@example.org

# Wer die Server stellt (Auftragsverarbeiter nach Art. 28 DSGVO). Wer selbst
# hostet, schreibt genau das hin – leer lassen ist keine Antwort.
# Ebenfalls mehrzeilig, gleiche Schreibweisen wie bei der Anschrift.
LEGAL_OPERATOR_HOSTING=Anbieter GmbH, Musterstadt\n(Rechenzentrum: Deutschland)

# Port (optional, Standard: 3000)
# PORT=3000

# Nur lokale Entwicklung: meldet über /api/dev-login ohne Telegram als Admin an.
# Wirkt ausschließlich, solange NODE_ENV nicht "production" ist – im
# Produktionsbetrieb wird die Route gar nicht erst registriert.
# DEV_LOGIN=1
# DEV_LOGIN_NAME=Dev-Benutzer
