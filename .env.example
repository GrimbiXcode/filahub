# ---------------------------------------------------------------------------
# Filament-Lager – Konfiguration (kopieren nach .env und ausfüllen)
# ---------------------------------------------------------------------------

# Zufälliges Secret zum Signieren der Sessions, z. B. erzeugen mit:
#   openssl rand -hex 32
APP_SECRET=bitte-zufaelligen-wert-eintragen

# MySQL-Verbindung
DATABASE_URL=mysql://benutzer:passwort@localhost:3306/filament_lager

# Telegram-Bot (bei @BotFather anlegen, siehe README)
TELEGRAM_BOT_TOKEN=123456789:ABCdeFGhiJKlmnoPQRstuVWxyz
TELEGRAM_BOT_USERNAME=DeinFilamentLagerBot

# Zugriffsbeschränkung: kommagetrennte Telegram-User-IDs.
# Deine eigene ID erfährst du, indem du dem Bot /id schreibst.
# Leer lassen = jeder Telegram-Nutzer darf sich registrieren.
TELEGRAM_ALLOWED_IDS=123456789

# Diese Telegram-ID wird Admin (typischerweise deine eigene)
OWNER_TELEGRAM_ID=123456789

# Port (optional, Standard: 3000)
# PORT=3000
